---
// HeroSection.astro — full-viewport-width hero with LCP-optimized photo background
// Hero photo: forest creek with autumn reflections (landscape 1600x1200 actual)
// Decision: option-creek selected (13-01-PLAN Task 1)
// Badge overlaid on hero per user feedback
---

<section class="hero">
  <picture>
    <source
      type="image/webp"
      srcset="
        /images/irrVhAXHnnFzslJGVemLiPEy5iQFbqZF6VzqxYOHL1o-2048x1536-640w.webp   640w,
        /images/irrVhAXHnnFzslJGVemLiPEy5iQFbqZF6VzqxYOHL1o-2048x1536-1280w.webp 1280w,
        /images/irrVhAXHnnFzslJGVemLiPEy5iQFbqZF6VzqxYOHL1o-2048x1536-1600w.webp 1600w
      "
      sizes="100vw"
    />
    <img
      class="hero-img"
      src="/images/irrVhAXHnnFzslJGVemLiPEy5iQFbqZF6VzqxYOHL1o-2048x1536.jpg"
      alt=""
      width="1600"
      height="1200"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    poster="/images/irrVhAXHnnFzslJGVemLiPEy5iQFbqZF6VzqxYOHL1o-2048x1536.jpg"
  >
    <source src="/Stationary_Hero_Video_With_Motion.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="badge">
      <svg class="badge-shape" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <path id="top-arc" d="M160 250 Q500 130 840 250" />
          <path id="bottom-arc" d="M280 700 Q500 830 720 700" />
        </defs>
        <path d="M500 70 150 175.3v217.1C150 785 500 930 500 930s350-145 350-537.6V175.2L500 70Z" fill="var(--color-forest-950)" stroke="var(--color-amber-500)" stroke-width="12" />
        <path d="M500 100 180 196v200C180 762 500 900 500 900s320-138 320-504V196L500 100Z" fill="none" stroke="var(--color-amber-500)" stroke-width="4" />
        <g transform="translate(460, 260) scale(2)">
          <path d="M20 2 L6 40 Q8 38 14 36 L18 50 L20 58 L22 50 L26 36 Q32 38 34 40 Z" fill="var(--color-amber-500)" />
        </g>
        <text class="badge-svg-top" text-anchor="middle">
          <textPath href="#top-arc" startOffset="50%">Hiawatha National Forest</textPath>
        </text>
        <text class="badge-svg-bottom" text-anchor="middle">
          <textPath href="#bottom-arc" startOffset="50%">&#x2022; Michigan &#x2022;</textPath>
        </text>
      </svg>
      <div class="badge-inner">
        <h1 class="badge-title">Hiawatha's Revenge</h1>
        <hr class="badge-rule" />
        <span class="badge-miles">100mi / 100k / 50k</span>
      </div>
    </div>
    <p class="hero-tagline">A ride that tests your legs and rewards your soul.</p>
    <div class="hero-date-block">
      <time class="hero-date" datetime="2026-06-06">June 6, 2026</time>
      <span class="hero-start-time">8 AM Start</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @supports not (height: 100svh) {
    .hero {
      height: 100vh;
    }
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: calc(100% + 60px);
    object-fit: cover;
    object-position: center top;
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 26, 13, 0.85) 0%,
      rgba(13, 26, 13, 0.4) 50%,
      rgba(13, 26, 13, 0.1) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem;
  }

  .badge {
    display: grid;
    width: 240px;
    filter: drop-shadow(4px 4px 0px rgba(0, 0, 0, 0.5));
  }

  .badge-shape,
  .badge-inner {
    grid-area: 1 / 1;
  }

  .badge-shape {
    display: block;
    width: 100%;
    height: auto;
  }

  .badge-svg-top {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    fill: var(--color-cream-200);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .badge-svg-bottom {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    fill: var(--color-cream-200);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .badge-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 15% 15% 25%;
    gap: 0.25rem;
  }

  .badge-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--font-size-xl);
    color: var(--color-amber-500);
    text-shadow: var(--shadow-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1;
    margin-top: 3rem;
  }

  .badge-rule {
    width: 60%;
    border: none;
    border-top: 1px solid var(--color-amber-500);
    opacity: 0.6;
    margin: 0.25rem 0;
  }

  .badge-miles {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-cream-50);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.5rem;
    margin-top: 0.25rem;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.875rem, 2vw, 1.25rem);
    color: var(--color-cream-100);
    margin-top: 1.5rem;
    max-width: 36rem;
  }

  .hero-date-block {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .hero-date {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-gold-500);
    letter-spacing: 0.08em;
  }

  .hero-start-time {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 1.5vw, 1rem);
    color: var(--color-cream-200);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-top: 0.125rem;
  }

  @media (min-width: 640px) {
    .badge {
      width: 340px;
    }
    .badge-title {
      font-size: var(--font-size-3xl);
    }
    .badge-miles {
      font-size: 0.625rem;
    }
    .hero-start-time {
      font-size: 1rem;
    }
  }
</style>

<script>
  const heroVideo = document.querySelector('.hero-video') as HTMLVideoElement | null;
  if (heroVideo) {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mq.matches) {
      heroVideo.pause();
    }
    mq.addEventListener('change', () => {
      if (mq.matches) {
        heroVideo.pause();
        heroVideo.style.display = 'none';
      } else {
        heroVideo.style.display = '';
        heroVideo.play().catch(() => {});
      }
    });
  }
</script>
