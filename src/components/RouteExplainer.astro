---
import photosData from '../../public/data/photos.json';
import ElevationSparkline from './ElevationSparkline.astro';
import ShieldMotif from './ShieldMotif.astro';
import SEGMENTS from './segments.json';

const DIFFICULTY_COLORS: Record<number, string> = {
  1: 'text-sun-400',      // easy — sun-yellow 9.46:1 contrast, text-safe
  2: 'text-sun-400',      // easy
  3: 'text-amber-500',    // moderate — amber primary accent
  4: 'text-scarlet-400',  // hard — scarlet-400 5.24:1 contrast, text-safe
  5: 'text-scarlet-400',  // hard
};

const SECTOR_IDS: Record<string, string> = {
  '520': 'sector-520',
  'NF2266': 'sector-nf2266',
  'Bass Lake Rd': 'sector-bass-lake',
  'NF2217-2218': 'sector-nf2217',
  'ND2225': 'sector-nd2225',
  'Doe Lake': 'sector-doe-lake',
  'Ridge Rd': 'sector-rapid-river',
};

function parseDims(filename: string): { w: number; h: number } {
  const m = filename.match(/-(\d+)x(\d+)/);
  return m ? { w: Number(m[1]), h: Number(m[2]) } : { w: 1536, h: 2048 };
}

const segmentsWithPhotos = SEGMENTS.map(seg => ({
  ...seg,
  photos: (photosData as any[])
    .filter((p: any) => p.mile >= seg.startMi && p.mile < seg.endMi),
}));
---

<section data-reveal class="route-explainer-section py-[--spacing-block]">
  <div class="py-10 max-w-4xl mx-auto px-4">
    <h2 class="text-3xl mb-[--spacing-element]">The Route, Segment by Segment</h2>
    <p class="max-w-prose text-cream-200 mb-8">
      100 miles of forest roads, two-track, and singletrack. Seven segments, each with its own character. Here's what to expect.
    </p>
    {segmentsWithPhotos.map((seg) => (
      <article id={SECTOR_IDS[seg.name] ?? ''} class="segment-card-container">
        {seg.photos.length > 0 && (
          <div class="segment-photo-grid">
            {seg.photos.map((photo: any) => {
              const dims = parseDims(photo.filename);
              return (
                <img
                  src={photo.thumb}
                  alt={`Route photo at mile ${photo.mile.toFixed(1)}`}
                  loading="lazy"
                  decoding="async"
                  width={dims.w}
                  height={dims.h}
                  style={`aspect-ratio: ${dims.w} / ${dims.h};`}
                  class="w-full h-auto block rounded-sm"
                />
              );
            })}
          </div>
        )}
        <div class="segment-body">
          <div class="flex items-center gap-2 mb-1">
            <ShieldMotif size={10} class={DIFFICULTY_COLORS[seg.difficulty] ?? 'text-amber-500'} />
            <h3 class={`text-xl font-display ${DIFFICULTY_COLORS[seg.difficulty] ?? 'text-amber-500'}`}>
              {seg.name}
            </h3>
          </div>
          <div class="flex items-center gap-3 text-sm text-cream-200 mt-1 mb-2">
            <span>{seg.distFromStart} from start</span>
            <span>·</span>
            <span>{seg.length}</span>
            <span>·</span>
            <div
              class="star-rating"
              style={`--rating: ${seg.difficulty};`}
              aria-label={`Difficulty: ${seg.difficulty} out of 5 stars`}
              role="img"
            ></div>
          </div>
          {seg.stravaId && (
            <a
              href={`https://www.strava.com/segments/${seg.stravaId}`}
              class="strava-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              View on Strava
              <svg class="strava-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M3 1.5L1.5 3 11.09 3l-8.59 8.59L3.91 13 12.5 4.41 12.5 14 14.5 14 14.5 1.5z" />
              </svg>
            </a>
          )}
          <p class="text-cream-100 leading-relaxed">{seg.description}</p>
          {SECTOR_IDS[seg.name] && (
            <ElevationSparkline sectorId={SECTOR_IDS[seg.name]} class="mt-3" />
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .route-explainer-section {
    background-color: var(--color-forest-950);
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="120"><path d="M0 20 Q50 8 100 20 Q150 32 200 20 Q250 8 300 20 Q350 32 400 20" stroke="%233d6b3d" stroke-width="1.5" fill="none"/><path d="M0 50 Q60 38 120 50 Q180 62 240 50 Q300 38 360 50 Q400 56 400 56" stroke="%233d6b3d" stroke-width="1" fill="none" opacity="0.6"/><path d="M0 85 Q80 73 160 85 Q240 97 320 85 Q380 77 400 85" stroke="%233d6b3d" stroke-width="0.75" fill="none" opacity="0.35"/></svg>');
    background-repeat: repeat;
    background-size: 400px 120px;
    border-top: 1px solid var(--color-forest-700);
    border-bottom: 1px solid var(--color-forest-700);
  }

  /* Card container — magazine-style with visible bg, border, shadow */
  .segment-card-container {
    background: var(--color-forest-800);
    border: 1px solid var(--color-forest-700);
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    margin-bottom: 2rem;
    overflow: hidden;
  }

  /* Stagger: cards hidden by default, revealed when parent section is visible */
  .segment-card-container {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* nth-child stagger — 100ms per card, 7 cards = 600ms max */
  .segment-card-container:nth-child(1) { transition-delay: 0ms; }
  .segment-card-container:nth-child(2) { transition-delay: 100ms; }
  .segment-card-container:nth-child(3) { transition-delay: 200ms; }
  .segment-card-container:nth-child(4) { transition-delay: 300ms; }
  .segment-card-container:nth-child(5) { transition-delay: 400ms; }
  .segment-card-container:nth-child(6) { transition-delay: 500ms; }
  .segment-card-container:nth-child(7) { transition-delay: 600ms; }

  /* Cards become visible when parent section is revealed */
  .route-explainer-section.is-visible .segment-card-container {
    opacity: 1;
    transform: translateY(0);
  }

  /* Reduced motion: cards always visible, no stagger */
  @media (prefers-reduced-motion: reduce) {
    .segment-card-container {
      opacity: 1;
      transform: none;
      transition: none;
      transition-delay: 0ms;
    }
  }

  /* Photo grid — responsive columns, each ≤400px wide */
  .segment-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 0.375rem;
    border-radius: 0.5rem 0.5rem 0 0;
    overflow: hidden;
  }

  /* Card body — padded content area */
  .segment-body {
    padding: 1.25rem;
  }

  /* Star rating — clip gradient technique with @supports progressive enhancement */
  .star-rating {
    --percent: calc(var(--rating) / 5 * 100%);
    display: inline-block;
    font-size: 1rem;
    line-height: 1;
    /* Solid amber fallback for browsers without background-clip: text support */
    color: var(--color-amber-500);
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .star-rating {
      background: linear-gradient(
        to right,
        var(--color-amber-500) var(--percent),
        var(--color-amber-300) var(--percent)  /* A11Y-03: was forest-700 (1.58:1) — amber-300 gives 5.30:1 on forest-800 */
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  }

  .star-rating::before {
    content: "★★★★★";
  }

  .strava-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-sm);
    color: #FC5200;
    text-decoration: none;
    margin-top: 0.5rem;
    transition: opacity 0.2s;
  }

  .strava-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .strava-icon {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .strava-link {
      transition: none;
    }
  }
</style>
