---
// AnimatedDivider.astro
// Animated section divider with scroll-triggered draw-on animation via IntersectionObserver.
// Geometric patterns inspired by Great Lakes Indigenous textile and beadwork traditions.
// Three visual variants: 'floral' (richest band), 'minimal' (single chevron), 'berry' (stepped zigzag).
// Animation: stroke-dashoffset with pathLength="1" (no getTotalLength needed).
// Accessibility: aria-hidden + role="presentation"; prefers-reduced-motion shows static fallback.

interface Props {
  variant?: 'floral' | 'minimal' | 'berry';
}
const { variant = 'floral' } = Astro.props;
---

<div class="animated-divider" aria-hidden="true" role="presentation">

  {variant === 'floral' && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 800 80"
      width="100%"
      height="80"
      aria-hidden="true"
      role="presentation"
      focusable="false"
    >
      <!--
        RAIL LINES — Static horizontal rails grounding the pattern.
        Top band at y=8/12/16, bottom band at y=64/68/72. forest-700.
      -->
      <line x1="0" y1="8"  x2="800" y2="8"  stroke="var(--color-forest-700)" stroke-width="2" />
      <line x1="0" y1="12" x2="800" y2="12" stroke="var(--color-forest-700)" stroke-width="1.5" />
      <line x1="0" y1="16" x2="800" y2="16" stroke="var(--color-forest-700)" stroke-width="2" />
      <line x1="0" y1="64" x2="800" y2="64" stroke="var(--color-forest-700)" stroke-width="2" />
      <line x1="0" y1="68" x2="800" y2="68" stroke="var(--color-forest-700)" stroke-width="1.5" />
      <line x1="0" y1="72" x2="800" y2="72" stroke="var(--color-forest-700)" stroke-width="2" />

      <!--
        ANIMATED CHEVRON BAND — A continuous zigzag polyline running the full 800px width.
        Draws on via stroke-dashoffset when scrolled into view.
        pathLength="1" normalizes the dash calculation.
        Points create a symmetric chevron wave mirrored at x=400.
      -->
      <polyline
        points="0,40 50,24 100,40 150,24 200,40 250,24 300,40 350,24 400,40 450,56 500,40 550,56 600,40 650,56 700,40 750,56 800,40"
        pathLength="1"
        stroke="var(--color-gold-500)"
        stroke-width="3"
        fill="none"
        class="vine-path"
      />

      <!--
        STATIC DECORATIVE ELEMENTS — arrowheads and diamonds.
        No vine-path class; appear immediately at full opacity.
      -->

      <!-- Center diamond at x=400 -->
      <polygon points="400,26 418,40 400,54 382,40" fill="var(--color-amber-500)" />
      <polygon points="400,32 410,40 400,48 390,40" fill="var(--color-amber-400)" />

      <!-- Arrowhead at x=200 (pointing left) -->
      <polygon points="184,40 202,30 202,50" fill="var(--color-gold-500)" />

      <!-- Arrowhead at x=600 (pointing right, mirror of x=200) -->
      <polygon points="616,40 598,30 598,50" fill="var(--color-gold-500)" />

      <!-- Small diamonds at x=100 / x=700 (symmetric) -->
      <polygon points="100,35 108,40 100,45 92,40" fill="var(--color-turquoise-500)" />
      <polygon points="700,35 708,40 700,45 692,40" fill="var(--color-turquoise-500)" />

      <!-- Small diamonds at x=300 / x=500 (symmetric) -->
      <polygon points="300,35 308,40 300,45 292,40" fill="var(--color-gold-400)" />
      <polygon points="500,35 508,40 500,45 492,40" fill="var(--color-gold-400)" />

    </svg>
  )}

  {variant === 'minimal' && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 800 40"
      width="100%"
      height="40"
      aria-hidden="true"
      role="presentation"
      focusable="false"
    >
      <!--
        RAIL LINES — Static horizontal rules at top and bottom. forest-700.
      -->
      <line x1="0" y1="5"  x2="800" y2="5"  stroke="var(--color-forest-700)" stroke-width="2" />
      <line x1="0" y1="35" x2="800" y2="35" stroke="var(--color-forest-700)" stroke-width="2" />

      <!--
        ANIMATED CHEVRON LINE — A single V-shaped chevron running the center 400px.
        Draws on via stroke-dashoffset. pathLength="1" normalizes length.
        Center at x=400 (400,10 -> 400,30 midpoint = 400,20).
      -->
      <polyline
        points="200,30 400,10 600,30"
        pathLength="1"
        stroke="var(--color-gold-500)"
        stroke-width="3"
        fill="none"
        class="vine-path"
      />

      <!--
        STATIC DECORATIVE ELEMENTS — Two flanking diamonds + center dot.
        No vine-path class; appear immediately.
      -->

      <!-- Flanking diamonds at x=160 / x=640 (symmetric) -->
      <polygon points="160,16 168,20 160,24 152,20" fill="var(--color-amber-500)" />
      <polygon points="640,16 648,20 640,24 632,20" fill="var(--color-amber-500)" />

      <!-- Center apex dot -->
      <circle cx="400" cy="10" r="4" fill="var(--color-gold-400)" />

    </svg>
  )}

  {variant === 'berry' && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 800 60"
      width="100%"
      height="60"
      aria-hidden="true"
      role="presentation"
      focusable="false"
    >
      <!--
        RAIL LINES — Static horizontal rules at y=5 and y=55. forest-700.
      -->
      <line x1="0" y1="5"  x2="800" y2="5"  stroke="var(--color-forest-700)" stroke-width="2" />
      <line x1="0" y1="55" x2="800" y2="55" stroke="var(--color-forest-700)" stroke-width="2" />

      <!--
        ANIMATED STEPPED ZIGZAG — A terraced/staircase path running full width,
        like a topographic contour stepped pattern.
        Bilateral symmetry around x=400. Draws on via stroke-dashoffset.
        pathLength="1" normalizes the length.
      -->
      <polyline
        points="0,42 100,42 100,30 200,30 200,18 300,18 300,30 400,30 400,18 500,18 500,30 600,30 600,42 700,42 700,30 800,30"
        pathLength="1"
        stroke="var(--color-turquoise-500)"
        stroke-width="2.5"
        fill="none"
        class="vine-path"
      />

      <!--
        STATIC DECORATIVE ELEMENTS — filled arrowheads and circles.
        No vine-path class; appear immediately at full opacity.
      -->

      <!-- Filled arrow/chevron at x=200 (pointing up) -->
      <polygon points="200,10 212,22 188,22" fill="var(--color-gold-500)" />

      <!-- Filled arrow/chevron at x=400 (pointing up, center) -->
      <polygon points="400,10 412,22 388,22" fill="var(--color-gold-500)" />

      <!-- Filled arrow/chevron at x=600 (pointing up, mirror of x=200) -->
      <polygon points="600,10 612,22 588,22" fill="var(--color-gold-500)" />

      <!-- Small filled circles at step peaks — scarlet-400 -->
      <circle cx="200" cy="18" r="3" fill="var(--color-scarlet-400)" />
      <circle cx="300" cy="18" r="3" fill="var(--color-scarlet-400)" />
      <circle cx="400" cy="18" r="3" fill="var(--color-scarlet-400)" />
      <circle cx="500" cy="18" r="3" fill="var(--color-scarlet-400)" />
      <circle cx="600" cy="18" r="3" fill="var(--color-scarlet-400)" />

      <!-- Small filled diamonds at x=100 / x=700 (flanking, symmetric) -->
      <polygon points="100,27 108,30 100,33 92,30" fill="var(--color-turquoise-500)" />
      <polygon points="700,27 708,30 700,33 692,30" fill="var(--color-turquoise-500)" />

    </svg>
  )}

</div>

<style>
  .animated-divider {
    max-width: 56rem;
    margin: 0 auto;
  }

  .vine-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .animated-divider.is-visible .vine-path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .vine-path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script>
  // Trigger draw-on animation for each AnimatedDivider instance independently.
  // querySelectorAll (not querySelector) ensures multiple instances on same page each fire.
  document.querySelectorAll('.animated-divider').forEach((divider) => {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          divider.classList.add('is-visible');
          observer.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    observer.observe(divider);
  });
</script>
