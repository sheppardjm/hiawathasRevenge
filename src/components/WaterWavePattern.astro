---
// WaterWavePattern.astro
// Stylized wave pattern inspired by Anishinaabe water/lake symbolism.
// Great Lakes region theme — flowing water forms.
// Can be placed as a section background accent at low opacity.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={["water-wave-pattern", className]} aria-hidden="true" role="presentation">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 60" width="100%" height="60" aria-hidden="true" role="presentation" focusable="false">
    <!-- Three layered wave paths — lake-500, turquoise-500, lake-400 -->
    <path d="M0,30 Q50,10 100,30 Q150,50 200,30 Q250,10 300,30 Q350,50 400,30 Q450,10 500,30 Q550,50 600,30 Q650,10 700,30 Q750,50 800,30" fill="none" stroke="var(--color-lake-500)" stroke-width="2" opacity="0.5" />
    <path d="M0,35 Q50,18 100,35 Q150,52 200,35 Q250,18 300,35 Q350,52 400,35 Q450,18 500,35 Q550,52 600,35 Q650,18 700,35 Q750,52 800,35" fill="none" stroke="var(--color-turquoise-500)" stroke-width="1.5" opacity="0.4" />
    <path d="M0,25 Q50,5 100,25 Q150,45 200,25 Q250,5 300,25 Q350,45 400,25 Q450,5 500,25 Q550,45 600,25 Q650,5 700,25 Q750,45 800,25" fill="none" stroke="var(--color-lake-400)" stroke-width="1" opacity="0.3" />

    <!-- Small dot accents at wave crests -->
    {[100, 300, 500, 700].map(x => (
      <circle cx={x} cy="30" r="3" fill="var(--color-turquoise-400)" opacity="0.4" />
    ))}
  </svg>
</div>
