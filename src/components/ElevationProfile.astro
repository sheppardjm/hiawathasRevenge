---
// ElevationProfile.astro — Chart.js elevation line chart with IntersectionObserver lazy-init
// Dynamic import in initChart() keeps Chart.js out of the initial bundle (~30KB vs ~200KB for chart.js/auto)
// Renders elevation (feet) vs distance (miles) from route-data.json points array
---

<div id="elevation-chart-container" class="relative w-full h-[140px] sm:h-[180px]">
  <canvas id="elevation-chart"></canvas>
</div>

<script>
  // Module-scope chart reference — allows route:change listener (defined below) to call updateChart()
  // without needing to reach into initChart()'s closure
  let chart = null;

  // CSS custom property helper — module scope so updateChart() can recalculate sector fill color
  function getCSSColor(varName) {
    return getComputedStyle(document.documentElement)
      .getPropertyValue(varName)
      .trim();
  }

  // Converts a CSS hex color token + alpha into an rgba() string for Chart.js
  function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  // updateChart — swaps dataset data, x-axis max, and sector band annotations in-place
  // Called by route:change listener when user switches routes
  async function updateChart(routeId) {
    if (!chart) return;

    const [routeData, annotations] = await Promise.all([
      fetch(`/data/${routeId}/route-data.json`).then(r => r.json()),
      fetch(`/data/${routeId}/annotations.json`).then(r => r.json()),
    ]);

    // Replace dataset data in-place (Chart.js v4 documented pattern)
    const newData = routeData.points.map(pt => ({
      x: pt.miles,
      y: +(pt.ele * 3.28084).toFixed(1)
    }));
    chart.data.datasets[0].data = newData;

    // Update x-axis max to new route distance
    chart.options.scales.x.max = routeData.meta.totalMiles;

    // Rebuild sector band annotations — preserve crosshair, replace all sector bands
    const SECTOR_BAND_FILL = hexToRgba(getCSSColor('--color-amber-500'), 0.18);
    const crosshair = chart.options.plugins.annotation.annotations.crosshair;
    const newAnnotations = { crosshair };
    const sectors = annotations.filter(a => a.type === 'sector');
    for (const sector of sectors) {
      newAnnotations[sector.id] = {
        type: 'box',
        xMin: sector.startMile,
        xMax: sector.endMile,
        backgroundColor: SECTOR_BAND_FILL,
        borderWidth: 0,
        drawTime: 'beforeDatasetsDraw'
      };
    }
    chart.options.plugins.annotation.annotations = newAnnotations;

    // Instant update — no animation on route switch
    chart.update('none');
  }

  // route:change listener — triggers chart data swap when user switches routes on the map
  window.addEventListener('route:change', (e) => {
    updateChart(e.detail.routeId);
  });

  async function initChart() {
    // Color variables — defined once, reused throughout initChart()
    const amber500 = getCSSColor('--color-amber-500');
    const cream200 = getCSSColor('--color-cream-200');

    // Sector band fill color — uniform for all sectors
    const SECTOR_BAND_FILL = hexToRgba(amber500, 0.18);

    // Dynamic import — tree-shaken (NOT chart.js/auto) to keep bundle small
    // Only import components needed for a line chart
    const {
      Chart,
      LineController,
      LineElement,
      PointElement,
      LinearScale,
      Filler,
      Tooltip,
      Decimation
    } = await import('chart.js');

    // Dynamic import of chartjs-plugin-annotation for crosshair line
    const { default: annotationPlugin } = await import('chartjs-plugin-annotation');

    // Register only what we use — avoids pulling in CategoryScale, BarController, etc.
    Chart.register(LineController, LineElement, PointElement, LinearScale, Filler, Tooltip, Decimation, annotationPlugin);

    // Fetch route data — same source as RouteMap.astro
    const routeData = await fetch('/data/100mi/route-data.json').then(r => r.json());

    // Build dataset: convert elevation from meters to feet, use miles for x-axis
    // parsing: false requires data to be in {x, y} format, sorted ascending by x
    const data = routeData.points.map(pt => ({
      x: pt.miles,
      y: +(pt.ele * 3.28084).toFixed(1)
    }));

    // Fetch annotations and build sector band overlays
    const annotations = await fetch('/data/100mi/annotations.json').then(r => r.json());
    const sectors = annotations.filter(a => a.type === 'sector');
    const sectorAnnotations = {};
    for (const sector of sectors) {
      sectorAnnotations[sector.id] = {
        type: 'box',
        xMin: sector.startMile,
        xMax: sector.endMile,
        // yMin/yMax intentionally omitted — auto-expands to full chart height
        backgroundColor: SECTOR_BAND_FILL,
        borderWidth: 0,
        drawTime: 'beforeDatasetsDraw'
      };
    }

    const canvas = document.getElementById('elevation-chart');
    chart = new Chart(canvas, {
      type: 'line',
      data: {
        datasets: [{
          data,
          // parsing: false REQUIRED at dataset level for LTTB decimation to function
          parsing: false,
          borderColor: amber500,
          backgroundColor: hexToRgba(amber500, 0.15),
          fill: 'start',
          pointRadius: 0,
          borderWidth: 1.5,
          tension: 0
        }]
      },
      options: {
        // parsing: false REQUIRED at options level for LTTB decimation to function
        parsing: false,
        responsive: true,
        // maintainAspectRatio: false — CSS container controls height (140px/180px)
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            mode: 'index',
            intersect: false,
            callbacks: {
              title: (items) => `Mile ${items[0].parsed.x.toFixed(1)}`,
              label: (item) => `${Math.round(item.parsed.y)} ft`
            }
          },
          decimation: {
            enabled: true,
            algorithm: 'lttb',
            samples: 300,
            threshold: 400
          },
          annotation: {
            annotations: {
              ...sectorAnnotations,
              crosshair: {
                type: 'line',
                xMin: 0,
                xMax: 0,
                display: false,
                borderColor: hexToRgba(amber500, 0.6),
                borderWidth: 1,
                borderDash: [4, 4]
              }
            }
          }
        },
        scales: {
          x: {
            type: 'linear',
            max: routeData.meta.totalMiles,
            title: { display: true, text: 'Distance (miles)', color: cream200 },
            ticks: { color: cream200, maxTicksLimit: 8 },
            grid: { color: 'rgba(255,255,255,0.08)' }
          },
          y: {
            type: 'linear',
            title: { display: true, text: 'Elevation (ft)', color: cream200 },
            ticks: {
              color: cream200,
              callback: (v) => `${Math.round(v)} ft`
            },
            grid: { color: 'rgba(255,255,255,0.08)' }
          }
        }
      }
    });

    // Direct canvas mousemove — bypasses Chart.js onHover which is unreliable with parsing:false in v4.5.1
    canvas.addEventListener('mousemove', (e) => {
      if (!chart) return;
      const rect = canvas.getBoundingClientRect();
      const pos = {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top
      };
      const miles = chart.scales.x.getValueForPixel(pos.x);
      if (miles == null) return;
      // Clamp to current route's valid range — uses live dataset (updates after route switch)
      const currentData = chart.data.datasets[0].data;
      const clamped = Math.max(0, Math.min(currentData[currentData.length - 1].x, miles));
      // Dispatch CustomEvent for RouteMap crosshair sync
      window.dispatchEvent(new CustomEvent('elevation:hover', { detail: { miles: clamped } }));
      // Update crosshair line position
      chart.options.plugins.annotation.annotations.crosshair.xMin = clamped;
      chart.options.plugins.annotation.annotations.crosshair.xMax = clamped;
      chart.options.plugins.annotation.annotations.crosshair.display = true;
      chart.update('none');
    });

    // Hide crosshair line and notify RouteMap when cursor leaves the chart
    canvas.addEventListener('mouseleave', () => {
      window.dispatchEvent(new CustomEvent('elevation:leave'));
      chart.options.plugins.annotation.annotations.crosshair.display = false;
      chart.update('none');
    });
  } // end initChart

  // IntersectionObserver lazy-init — loads Chart.js only when container enters viewport.
  // The map section above already uses a scroll listener as its primary trigger;
  // IO alone is sufficient for the elevation chart below it.
  let chartInitialized = false;
  const container = document.getElementById('elevation-chart-container');

  if (container) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting && !chartInitialized) {
          chartInitialized = true;
          observer.disconnect();
          initChart();
        }
      },
      { rootMargin: '0px' }
    );
    observer.observe(container);
  }
</script>
