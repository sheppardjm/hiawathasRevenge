---
// PhotoGallery.astro — Masonry photo gallery with PhotoSwipe lightbox
// CSS columns layout with natural aspect ratios and featured full-width treatment
// PhotoSwipe initialized in <script> block (not frontmatter) to avoid SSR "window is undefined" errors
import photosData from '../../public/data/photos.json';

type PhotoEntry = {
  id: string;
  filename: string;
  thumb: string;
  mile: number;
  lat?: number;
  lon?: number;
  featured?: boolean;
};

const photos = photosData as PhotoEntry[];

// Extracts pixel dimensions from source filenames like "photo-name-1536x2048.jpg"
// Used to set data-pswp-width / data-pswp-height on lightbox anchor elements
function parseDims(filename: string): { w: number; h: number } {
  const m = filename.match(/-(\d+)x(\d+)/);
  return m ? { w: Number(m[1]), h: Number(m[2]) } : { w: 1536, h: 2048 };
}
---

{photos.length === 0 ? (
  <p class="text-cream-200 text-sm italic">Photos coming soon.</p>
) : (
  <div id="photo-gallery" class="columns-1 sm:columns-2 lg:columns-3 gap-3">
    {photos.map((photo) => {
      const dims = parseDims(photo.filename);
      return (
        <a
          href={`/images/${photo.filename}`}
          data-pswp-width={dims.w}
          data-pswp-height={dims.h}
          target="_blank"
          rel="noopener"
          class:list={[
            "block mb-3 break-inside-avoid overflow-hidden rounded-sm img-skeleton",
            photo.featured && "featured-photo"
          ]}
        >
          <img
            src={photo.thumb}
            alt={`Route photo at mile ${photo.mile.toFixed(1)}`}
            loading="lazy"
            decoding="async"
            width={dims.w}
            height={dims.h}
            style={`aspect-ratio: ${dims.w} / ${dims.h}; background: var(--color-forest-800);`}
            class="w-full h-auto block"
          />
        </a>
      );
    })}
  </div>
)}

<style>
  .featured-photo {
    column-span: all;
    margin-bottom: 0.75rem;
  }

  .featured-photo img {
    max-height: 60vh;
    object-fit: cover;
    width: 100%;
  }

  /* PERF-01: Skeleton shimmer — shown until image loads, then .loaded removes animation */
  .img-skeleton {
    background: linear-gradient(
      90deg,
      var(--color-forest-800) 25%,
      var(--color-forest-700) 50%,
      var(--color-forest-800) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
    min-height: 200px;
  }

  .img-skeleton.loaded {
    background: none;
    animation: none;
    min-height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .img-skeleton {
      animation: none;
      background: var(--color-forest-800);
    }
  }
</style>

<script>
  // PERF-01: Remove skeleton shimmer once each image loads
  document.querySelectorAll('.img-skeleton').forEach(wrapper => {
    const img = wrapper.querySelector('img');
    if (!img) return;

    function markLoaded() {
      wrapper.classList.add('loaded');
    }

    // img.complete can be true for lazy images that haven't fetched yet —
    // also check naturalHeight to confirm actual pixel data exists
    if (img.complete && img.naturalHeight > 0) {
      markLoaded();
    } else {
      img.addEventListener('load', markLoaded, { once: true });
      img.addEventListener('error', markLoaded, { once: true });
    }
  });

  // PhotoSwipe lightbox — imported in <script> block so Vite bundles it client-side only
  // pswpModule uses dynamic import to defer the 30KB core until the user clicks a thumbnail
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // Module-scope lightbox — accessible by map:photoClick listener below
  // MUST be at module scope, not inside the if (gallery) block — closure won't capture it otherwise
  let lightbox = null;

  // Guard prevents errors when photos.json is empty (no #photo-gallery div rendered)
  const gallery = document.getElementById('photo-gallery');
  if (gallery) {
    lightbox = new PhotoSwipeLightbox({
      gallery: '#photo-gallery',
      children: 'a',
      pswpModule: () => import('photoswipe')
    });
    lightbox.init();
  }

  // Bridge: map photo marker click -> open lightbox at the clicked photo
  // Matches CustomEvent dispatched by RouteMap.astro cluster marker click handlers
  // gallery element MUST be passed explicitly — PhotoSwipe needs it for DOM-connected galleries
  window.addEventListener('map:photoClick', (e) => {
    if (!lightbox) return;
    lightbox.loadAndOpen(e.detail.photoIndex, {
      gallery: document.getElementById('photo-gallery')
    });
  });
</script>
