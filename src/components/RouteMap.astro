---
// RouteMap.astro — Leaflet interactive map with CyclOSM tiles and GPX route polyline
// Dynamic imports in <script> prevent SSR "window is undefined" errors
// Leaflet CSS is imported via global.css in @layer leaflet (not here)
---

<div id="map" class="route-map"></div>

<style>
  .route-map {
    width: 100%;
    height: 60vh;
    min-height: 400px;
    position: relative;
    z-index: 0;
  }
</style>

<script>
  async function initMap() {
    // Dynamic import avoids SSR "window is undefined" error — Leaflet requires browser globals
    const L = (await import('leaflet')).default;

    // Wire GestureHandling BEFORE map init — addInitHook must be called before L.map()
    const { GestureHandling } = await import('leaflet-gesture-handling');
    L.Map.addInitHook('addHandler', 'gestureHandling', GestureHandling);

    // Initialize map with gestureHandling enabled
    const map = L.map('map', { gestureHandling: true });

    // CyclOSM tile layer — no API key required, forest-themed rendering
    L.tileLayer('https://{s}.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png', {
      attribution: '<a href="https://github.com/cyclosm/cyclosm-cartocss-style/releases" title="CyclOSM - Open Bicycle render">CyclOSM</a> | Map data: &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      subdomains: 'abc',
      maxZoom: 20
    }).addTo(map);

    // Custom reset control — appears below zoom buttons (top-left)
    const ResetControl = L.Control.extend({
      options: { position: 'topleft' },
      onAdd() {
        const container = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
        const btn = L.DomUtil.create('a', '', container);
        btn.href = '#';
        btn.title = 'Reset view';
        btn.setAttribute('role', 'button');
        btn.setAttribute('aria-label', 'Reset map to default view');
        btn.innerHTML = '&#8635;';
        L.DomEvent.disableClickPropagation(container);
        L.DomEvent.on(btn, 'click', (e) => {
          L.DomEvent.preventDefault(e);
          map.fitBounds(initialBounds, { padding: [20, 20] });
          map.closePopup();
        });
        return container;
      }
    });
    new ResetControl().addTo(map);

    // Fetch route data and render polyline
    const routeData = await fetch('/data/route-data.json').then(r => r.json());
    const latlngs = routeData.points.map((pt) => [pt.lat, pt.lon]);

    const routeLine = L.polyline(latlngs, {
      color: '#1a2e1a',
      weight: 4,
      opacity: 0.9,
      smoothFactor: 1
    }).addTo(map);

    // Auto-fit map to the full route bounds
    map.fitBounds(routeLine.getBounds(), { padding: [20, 20] });

    // Capture initial bounds for reset — must be stored after fitBounds
    const initialBounds = routeLine.getBounds();
  } // end initMap

  // Defer Leaflet/map loading until the user begins scrolling toward the map section.
  // Two-stage lazy-init pattern:
  //   1. Scroll event: fires when user starts scrolling (primary trigger)
  //   2. IntersectionObserver fallback: fires when map is visible (handles direct #route anchor navigation)
  let mapInitialized = false;
  const mapEl = document.getElementById('map');

  function tryInitMap() {
    if (!mapInitialized) {
      mapInitialized = true;
      initMap();
    }
  }

  if (mapEl) {
    // Primary trigger: scroll event — fires on first scroll, immediately loads map
    window.addEventListener('scroll', tryInitMap, { once: true, passive: true });

    // Secondary trigger: IntersectionObserver (only when map is truly visible)
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          tryInitMap();
        }
      },
      { rootMargin: '0px' }
    );
    observer.observe(mapEl);
  }
</script>
