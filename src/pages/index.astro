---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteMap from '../components/RouteMap.astro';
import ElevationProfile from '../components/ElevationProfile.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import RouteStats from '../components/RouteStats.astro';
import DonateCallout from '../components/DonateCallout.astro';
---

<BaseLayout title="Hiawatha's Revenge | 100 Miles Through the Hiawatha National Forest">

  <section class="py-[--spacing-section] flex flex-col items-center text-center">
    <div class="badge">
      <svg class="badge-shape" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Top text arc — curves along upper shield interior -->
          <path id="top-arc" d="M160 250 Q500 130 840 250" />
          <!-- Bottom text arc — curves along lower shield interior -->
          <path id="bottom-arc" d="M280 700 Q500 830 720 700" />
        </defs>

        <!-- Outer shield -->
        <path d="M500 70 150 175.3v217.1C150 785 500 930 500 930s350-145 350-537.6V175.2L500 70Z" fill="var(--color-forest-950)" stroke="var(--color-amber-500)" stroke-width="12" />
        <!-- Inner border -->
        <path d="M500 100 180 196v200C180 762 500 900 500 900s320-138 320-504V196L500 100Z" fill="none" stroke="var(--color-amber-500)" stroke-width="4" />

        <!-- Arrowhead icon -->
        <g transform="translate(460, 260) scale(2)">
          <path d="M20 2 L6 40 Q8 38 14 36 L18 50 L20 58 L22 50 L26 36 Q32 38 34 40 Z" fill="var(--color-amber-500)" />
        </g>

        <!-- Curved top text -->
        <text class="badge-svg-top" text-anchor="middle">
          <textPath href="#top-arc" startOffset="50%">Hiawatha National Forest</textPath>
        </text>

        <!-- Bottom curved text -->
        <text class="badge-svg-bottom" text-anchor="middle">
          <textPath href="#bottom-arc" startOffset="50%">&#x2022; Michigan &#x2022;</textPath>
        </text>
      </svg>
      <div class="badge-content">
        <h1 class="badge-title">Hiawatha's Revenge</h1>
        <hr class="badge-rule" />
        <span class="badge-miles">100 Miles</span>
      </div>
    </div>
    <p class="text-xl text-cream-200 max-w-2xl mt-8">
      A ride that tests your legs and rewards your soul.
    </p>
  </section>

  <section class="py-[--spacing-block] flex justify-center">
    <DonateCallout />
  </section>

  <div class="topo-divider"></div>

  <section class="py-[--spacing-block]">
    <h2 class="text-3xl mb-[--spacing-element]">The Route</h2>
    <div class="max-w-prose space-y-4 text-cream-100 leading-relaxed">
      <p>
        In 1855, Henry Wadsworth Longfellow published <em>The Song of Hiawatha</em>,
        an epic poem that drew on Ojibwe oral traditions collected by ethnographer
        Henry Rowe Schoolcraft. Set along the shores of Lake Superior in Michigan's
        Upper Peninsula, the poem wove together legends of the trickster-hero
        Manabozho under the borrowed name of Hiawatha — a figure from the
        Haudenosaunee (Iroquois) Confederacy far to the east.
      </p>
      <p>
        Longfellow's poem reshaped how Americans imagined this landscape. When the
        federal government designated nearly 900,000 acres of Upper Peninsula forest
        as a National Forest in 1931, they named it after the poem's protagonist:
        the Hiawatha National Forest. Today the forest stretches across the peninsula
        from Lake Superior to Lake Michigan, sheltering over 100 miles of Great Lakes
        shoreline, pristine inland lakes, and dense hardwood wilderness.
      </p>
      <p>
        Hiawatha's Revenge is a 100-mile cycling route that threads through the
        heart of this forest. Starting and ending in Munising, the route follows
        quiet forest roads, rugged two-track, and remote singletrack past
        landscapes that have changed little since Schoolcraft documented the Ojibwe
        stories that would one day name this land. It is a ride that tests your
        legs and rewards your soul.
      </p>
      <p>
        The route is organized by the
        <a href="https://mbtn.org" class="underline hover:text-amber-300">Munising Bay Trail Network</a>
        (MBTN), a 501(c)(3) nonprofit that builds and maintains singletrack trails
        across the Hiawatha National Forest. Every mile you ride supports their
        work preserving access to this extraordinary landscape.
      </p>
    </div>
  </section>

  <section class="py-[--spacing-block]">
    <h2 class="text-3xl mb-[--spacing-element]">Route Stats</h2>
    <RouteStats />
  </section>

  <section class="py-[--spacing-block] flex flex-col items-center gap-2">
    <a
      href="/Munising_Hiawatha_s_Revenge.gpx"
      download="HiawathasRevenge.gpx"
      class="gpx-download"
    >
      Download GPX File
    </a>
    <span class="text-xs text-cream-200">Load this route onto your GPS device</span>
  </section>

  <div class="topo-divider"></div>

  <section id="route" class="py-[--spacing-block]">
    <h2 class="text-3xl mb-[--spacing-element]">Explore the Route</h2>
    <RouteMap />
  </section>

  <section class="py-[--spacing-block]">
    <h2 class="text-3xl mb-[--spacing-element]">Elevation Profile</h2>
    <ElevationProfile />
  </section>

  <section class="py-[--spacing-block]">
    <h2 class="text-3xl mb-[--spacing-element]">Photos</h2>
    <PhotoGallery />
  </section>

  <section class="py-[--spacing-block]">
    <h2 class="text-3xl mb-[--spacing-element]">Support the Trail</h2>
    <DonateCallout />
  </section>

  <section class="py-[--spacing-block] border-t border-forest-700 mt-[--spacing-section]">
    <p class="text-sm text-cream-200">
      A project supporting <a href="https://mbtn.org" class="underline hover:text-amber-300">MBTN</a>.
    </p>
  </section>

</BaseLayout>

<style>
  .badge {
    position: relative;
    width: 300px;
    filter: drop-shadow(4px 4px 0px rgba(0, 0, 0, 0.5));
  }

  .badge-shape {
    display: block;
    width: 100%;
    height: auto;
  }

  .badge-svg-top {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    fill: var(--color-cream-200);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .badge-svg-bottom {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    fill: var(--color-cream-200);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .badge-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 15% 15% 25%;
    gap: 0.25rem;
  }

  .badge-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--font-size-xl);
    color: var(--color-amber-500);
    text-shadow: var(--shadow-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1;
    margin-top: 3rem;
  }

  .badge-rule {
    width: 60%;
    border: none;
    border-top: 1px solid var(--color-amber-500);
    opacity: 0.6;
    margin: 0.25rem 0;
  }

  .badge-miles {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-cream-50);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: var(--font-size-sm);
    margin-top: 0.25rem;
  }

  .gpx-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border: 2px solid var(--color-forest-700);
    padding: 0.5rem 1.5rem;
    color: var(--color-amber-400);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .gpx-download:hover {
    border-color: var(--color-amber-500);
    color: var(--color-amber-300);
  }

  @media (min-width: 640px) {
    .badge {
      width: 420px;
    }
    .badge-title {
      font-size: var(--font-size-3xl);
    }
    .badge-miles {
      font-size: var(--font-size-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gpx-download {
      transition: none;
    }
  }
</style>
