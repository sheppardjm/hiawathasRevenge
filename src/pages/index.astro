---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import RouteMap from '../components/RouteMap.astro';
import ElevationProfile from '../components/ElevationProfile.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import RouteStats from '../components/RouteStats.astro';
import DonateCallout from '../components/DonateCallout.astro';
import FloralDivider from '../components/FloralDivider.astro';
import AnimatedDivider from '../components/AnimatedDivider.astro';
import ShieldMotif from '../components/ShieldMotif.astro';
import OjibweBorderPattern from '../components/OjibweBorderPattern.astro';
import WaterWavePattern from '../components/WaterWavePattern.astro';
import TurtleMotif from '../components/TurtleMotif.astro';
import HiawathaExplainer from '../components/HiawathaExplainer.astro';
import RouteExplainer from '../components/RouteExplainer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import StickyNav from '../components/StickyNav.astro';
import RideEthos from '../components/RideEthos.astro';
---

<BaseLayout title="Hiawatha's Revenge | 100 Miles Through the Hiawatha National Forest">

  <HeroSection />

  <StickyNav />
  <RideEthos />

  <section class="gold-section w-full py-16">
    <div class="max-w-4xl mx-auto px-4 flex justify-center">
      <DonateCallout />
    </div>
  </section>

  <FloralDivider />

  <HiawathaExplainer />

  <RouteExplainer />

  <AnimatedDivider variant="minimal" />

  <section data-reveal class="amber-section w-full py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl mb-[--spacing-element]">Route Stats</h2>
      <RouteStats />
    </div>
  </section>

  <section data-reveal class="bg-forest-800 w-full py-16">
    <div class="max-w-4xl mx-auto px-4 flex flex-col items-center gap-2">
      <a
        id="gpx-download-link"
        href="/Munising_Hiawatha_s_Revenge.gpx"
        download="HiawathasRevenge.gpx"
        class="gpx-download"
      >
        Download GPX File
      </a>
      <span class="text-xs text-cream-200">Load this route onto your GPS device</span>
      <p class="text-xs text-cream-200 text-center max-w-xs">
        Use the route selector in the map below to switch between 100 Mile, 100K, and 50K before downloading.
      </p>
    </div>
  </section>

  <AnimatedDivider variant="berry" />

  <OjibweBorderPattern class="px-4 py-3" />

  <section data-reveal id="route" class="w-full py-[--spacing-block]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl mb-[--spacing-element]">Explore the Route</h2>
      <RouteMap />
    </div>
  </section>

  <section data-reveal class="bg-forest-950 w-full py-[--spacing-block]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl mb-[--spacing-element]">Elevation Profile</h2>
      <ElevationProfile />
    </div>
  </section>

  <WaterWavePattern class="my-4 opacity-60" />

  <section id="gallery" class="w-full py-[--spacing-block]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl mb-[--spacing-element]">Photos</h2>
      <PhotoGallery />
    </div>
  </section>

  <AnimatedDivider variant="floral" />

  <section data-reveal class="teal-section w-full py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl mb-[--spacing-element]">Support the Trail</h2>
      <DonateCallout />
    </div>
  </section>

  <section data-reveal class="bg-forest-950 w-full py-[--spacing-block] pb-8 border-t border-forest-700 mt-[--spacing-section]">
    <div class="max-w-4xl mx-auto px-4">
      <ShieldMotif size={16} class="text-amber-500 mb-3 opacity-60 inline-block" />
      <TurtleMotif size={16} class="text-turquoise-400 mb-3 opacity-50 inline-block ml-3" />
      <p class="text-sm text-cream-200">
        A project supporting <a href="https://mbtn.org" class="underline hover:text-amber-300">MBTN</a>.
      </p>
      <p class="text-xs text-cream-200 mt-3 max-w-prose leading-relaxed">
        Decorative elements on this site are inspired by the woodland floral beadwork
        tradition of the Ojibwe (Anishinaabe) people, the original stewards of the
        Hiawatha National Forest region and surrounding Great Lakes homeland.
        The Ojibwe remain a living, contemporary culture.
      </p>
    </div>
  </section>

  <ScrollReveal />

</BaseLayout>

<style>

  /* ============================================================
     Section background color overrides — "yellow, orange, teal"
     UAT gap closure: Test 12 (section color variety)
     :global() required to pierce Astro scoped styles in DonateCallout
     ============================================================ */

  /* Gold/yellow section — sun-500 bg, dark text (forest-950) */
  .gold-section {
    background-color: var(--color-sun-500);
    color: var(--color-forest-950);
  }
  .gold-section :global(h2),
  .gold-section :global(h3) {
    color: var(--color-forest-950);
    text-shadow: none;
  }
  .gold-section :global(.donate-message) {
    color: var(--color-forest-900);
  }
  .gold-section :global(.donate-button) {
    color: var(--color-forest-950);
    border-color: var(--color-forest-900);
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.2);
  }
  .gold-section :global(.donate-button:hover) {
    background-color: var(--color-forest-950);
    color: var(--color-sun-300);
  }
  .gold-section :global(a) {
    color: var(--color-forest-800);
  }

  .gold-section :global(a:focus-visible),
  .gold-section :global(button:focus-visible) {
    outline-color: var(--color-forest-950);
  }

  /* Amber/orange section — amber-500 bg, dark text (forest-950) */
  .amber-section {
    background-color: var(--color-amber-500);
    color: var(--color-forest-950);
  }
  .amber-section :global(h2),
  .amber-section :global(h3) {
    color: var(--color-forest-950);
    text-shadow: none;
  }
  .amber-section :global(p),
  .amber-section :global(span) {
    color: var(--color-forest-900);
  }

  /* VIS-05: Route stats legibility — override amber-section span color on stat cards */
  .amber-section :global(.stat-value) {
    color: var(--color-amber-500);
  }
  .amber-section :global(.stat-label) {
    color: var(--color-cream-200);
  }
  .amber-section :global(.surface-name) {
    color: var(--color-forest-950);
  }
  .amber-section :global(.surface-miles) {
    color: var(--color-forest-900);
  }
  .amber-section :global(.comparison-name) {
    color: var(--route-color);
  }

  /* Teal section — turquoise-700 bg, cream text, sun-400 headings */
  .teal-section {
    background-color: var(--color-turquoise-700);
  }
  .teal-section :global(h2) {
    color: var(--color-sun-400);
  }
  .teal-section :global(.donate-message) {
    color: var(--color-cream-100);
  }
  .teal-section :global(.donate-button) {
    border-color: var(--color-cream-100);
    color: var(--color-cream-100);
  }
  .teal-section :global(.donate-button:hover) {
    background-color: var(--color-cream-100);
    color: var(--color-turquoise-700);
  }

  .gpx-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border: 2px solid var(--color-forest-700);
    padding: 0.5rem 1.5rem;
    color: var(--color-amber-400);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .gpx-download:hover {
    border-color: var(--color-amber-500);
    color: var(--color-amber-300);
  }

  @media (prefers-reduced-motion: reduce) {
    .gpx-download {
      transition: none;
    }
  }

  /* NAV-03: Offset anchor targets so section headings are not obscured by sticky nav.
     :global() is required because #history and #sectors are rendered by child components
     (HiawathaExplainer.astro and RouteExplainer.astro) and would not match Astro's
     scoped data-attribute selector without it. */
  :global(#history),
  :global(#route),
  :global(#gallery),
  :global(#sectors) {
    scroll-margin-top: 52px;
  }
</style>

<script>
  // GPX download link — route-aware href and label
  // Updates the download link when the user switches routes via the RouteSelector
  let _routesCache = null;
  async function getRoutes() {
    if (!_routesCache) _routesCache = await fetch('/data/routes.json').then(r => r.json());
    return _routesCache;
  }

  window.addEventListener('route:change', async (e) => {
    const data = await getRoutes();
    const route = data.routes.find(r => r.id === e.detail.routeId);
    if (!route) return;
    const link = document.getElementById('gpx-download-link');
    if (!link) return;
    link.href = '/' + route.gpxFile;
    link.download = 'HiawathasRevenge-' + route.shortName + '.gpx';
    link.textContent = 'Download ' + route.name + ' GPX';
  });
</script>
